# 平台运行时数据(bbolt 数据库、JWT 密钥、JSON fallback)
# 覆盖 data/ 及所有 data-<用途>/ 变体(如 data-panelv2/)——
# JWT 签名密钥与数据库一旦被提交,可伪造任意管理员 JWT。
data/
data-*/

# QA 运行时工作区(用后即弃的验证环境与一次性配置)
# —— qa/ 新增内容一律不入库: 里面有明文 *.key 和一次性截图(实测 146MB)。
#     历史已入库的 191 个 qa 文件保持原样, 不再新增; 需要长期留存的验收证据
#     请挑单张放进 docs/audit/。
qa/
data-qa*
config-qa*
deploy/e2e-results/
server-*.log

# QA 运行日志(含各端口验证实例遗留)
logs-*.log
logs-qa*.txt
qa/serve-*.log
qa/*.log

# 一次性审计配置(如 config-audit.yaml)——避免误提交
config-audit*.yaml
